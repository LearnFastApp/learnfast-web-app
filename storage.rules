rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ai-recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /guest-recordings/{guestUid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == guestUid;
      allow read: if false;
    }
    // Org logo uploads — publicly readable, writable by org admins/owners.
    match /org-logos/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'physicalperformance@icloud.com' ||
        (
          firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'] &&
          firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
        )
      );
    }
    // Library content uploads — org admins/owners and platform admin only.
    match /org-content/{orgId}/{allPaths=**} {
      // Reads: org members only
      allow read: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));

      // Writes: platform admin OR org owner/admin with active status
      allow write: if request.auth != null && (
        request.auth.token.email == 'physicalperformance@icloud.com' ||
        (
          firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'] &&
          firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
        )
      );
    }
    match /premium-content/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'physicalperformance@icloud.com';
    }
  }
}
