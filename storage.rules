rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // AI assessment recordings — authenticated users can write only to their own folder
    match /ai-recordings/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 500 * 1024 * 1024;
      allow read: if false; // download URLs use access tokens, not rules
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
