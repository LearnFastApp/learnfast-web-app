rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ai-recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /guest-recordings/{guestUid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == guestUid;
      allow read: if false;
    }
    // Org logo uploads — publicly readable, writable by org admins/owners.
    // Read from presenters/{uid} (user can always read their own doc) rather than
    // the members sub-collection (which triggers a recursive Firestore rule check).
    match /org-logos/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'physicalperformance@icloud.com' ||
        (
          firestore.get(/databases/(default)/documents/presenters/$(request.auth.uid)).data.orgId == orgId &&
          firestore.get(/databases/(default)/documents/presenters/$(request.auth.uid)).data.orgRole in ['owner', 'admin']
        )
      );
    }
    // Library content uploads — org admins/owners and platform admin only.
    match /org-content/{orgId}/{allPaths=**} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/presenters/$(request.auth.uid)).data.orgId == orgId;

      allow write: if request.auth != null && (
        request.auth.token.email == 'physicalperformance@icloud.com' ||
        (
          firestore.get(/databases/(default)/documents/presenters/$(request.auth.uid)).data.orgId == orgId &&
          firestore.get(/databases/(default)/documents/presenters/$(request.auth.uid)).data.orgRole in ['owner', 'admin']
        )
      );
    }
    match /premium-content/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'physicalperformance@icloud.com';
    }
    match /coach-headshots/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == 'physicalperformance@icloud.com';
    }
  }
}
