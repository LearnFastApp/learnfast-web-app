rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /ai-recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /guest-recordings/{guestUid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == guestUid;
      allow read: if false;
    }
    // Library content uploads — org admins and platform admin upload via client SDK.
    // Org membership/role is validated in the API before the Firestore record is created.
    match /org-content/{orgId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /premium-content/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.email == 'physicalperformance@icloud.com';
    }
  }
}
