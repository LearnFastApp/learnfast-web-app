rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // AI assessment recordings — authenticated users can write to their own folder only
    match /ai-recordings/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if false;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
